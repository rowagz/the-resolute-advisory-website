<!-- ═══ §05 ENGAGEMENT ═══ -->
<section class="c-sec engagement" id="engagement" aria-labelledby="eng-heading" data-screen-label="05 Engagement">
  <div class="engagement-inner">
    <div class="c-head">
      <div class="c-label c-label--ghost">§ 05 — Engagement</div>
      <h2 class="c-title c-title--white" id="eng-heading">Four phases.<br>No retainers.</h2>
      <p class="c-sub c-sub--ghost">We diagnose, we recommend, we implement, and we hand you a system your team can
        run without us. The mandate has an end date by design.</p>
    </div>
    <div class="eng-grid">
      <div class="eng-cell">
        <span class="eng-n">01</span>
        <div class="eng-phase">Diagnose</div>
        <p class="eng-desc">Audit what exists. Pressure-test the brief. Define the real problem — usually not the
          one you arrived with.</p>
      </div>
      <div class="eng-cell">
        <span class="eng-n">02</span>
        <div class="eng-phase">Recommend</div>
        <p class="eng-desc">Direction, decisions, sequencing. A short memo with what to do, what not to do, and why.
        </p>
      </div>
      <div class="eng-cell">
        <span class="eng-n">03</span>
        <div class="eng-phase">Implement</div>
        <p class="eng-desc">The same team that recommended. Ships into production — sites live, packs printed,
          systems deployed, campaigns run.</p>
      </div>
      <div class="eng-cell">
        <span class="eng-n">04</span>
        <div class="eng-phase">Institutionalise</div>
        <p class="eng-desc">Guidelines, playbooks, and the operating system your team extends without us. We leave
          when the work outlives us.</p>
      </div>
    </div>
  </div>
</section>
