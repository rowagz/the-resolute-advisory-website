---
import BriefForm from './BriefForm';
---

<!-- ═══ §08 BRIEF ═══ -->
<section class="c-sec brief" id="brief" aria-labelledby="brief-heading" data-screen-label="08 Brief">
  <div class="brief-inner">
    <div class="brief-head">
      <h2 class="brief-title" id="brief-heading">
        Tell us what you're solving.<br>
        <em>We'll tell you what it needs.</em>
      </h2>
    </div>

    <BriefForm client:load />

    <div class="brief-aside">
      <div class="b-aside-block">
        <span class="b-aside-lbl">Direct</span>
        <span class="b-aside-val"><a
            href="mailto:hello@theresoluteadvisory.com">hello@theresoluteadvisory.com</a></span>
      </div>
      <div class="b-aside-block">
        <span class="b-aside-lbl">Response</span>
        <span class="b-aside-val">48 hours or sooner</span>
        <span class="b-aside-sub">Senior partner, not a coordinator.</span>
      </div>
      <div class="b-aside-block">
        <span class="b-aside-lbl">Where</span>
        <span class="b-aside-val">Mumbai · Toronto · Singapore</span>
      </div>
      <div class="b-aside-block">
        <span class="b-aside-lbl">Engagements</span>
        <span class="b-aside-val">Open · Q3 2026</span>
        <span class="b-aside-sub">Fixed mandate. No retainers.</span>
      </div>
    </div>
  </div>
</section>
