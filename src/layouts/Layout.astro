---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0F1A2E">

  <!-- Primary SEO -->
  <title>Resolute Advisory — Operator-Led Consultancy | Brand, Trade, Tech, Automation, Agri</title>
  <meta name="description"
    content="Resolute Advisory is an operator-led consultancy. We diagnose what's actually wrong across brand and growth, trade and export, technology, automation, and agriculture — and we stay to implement the fix. Mumbai · Toronto · Singapore.">
  <meta name="keywords"
    content="operator-led consultancy, brand strategy, growth strategy, trade and export consulting, agentic AI consulting, automation consulting, agritech consulting, India consultancy, Toronto consultancy, Singapore consultancy, fintech consulting, D2C consulting">
  <meta name="author" content="Resolute Advisory">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <link rel="canonical" href="https://theresoluteadvisory.com/">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Resolute Advisory">
  <meta property="og:title" content="Resolute Advisory — Most problems aren't what they look like.">
  <meta property="og:description"
    content="Operator-led consultancy. Five practices. One bench. We diagnose, recommend, implement, and institutionalise. Mumbai · Toronto · Singapore.">
  <meta property="og:url" content="https://theresoluteadvisory.com/">
  <meta property="og:image" content="https://theresoluteadvisory.com/assets/og-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Resolute Advisory — operator-led consultancy. Five practices. One bench.">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Resolute Advisory — Most problems aren't what they look like.">
  <meta name="twitter:description"
    content="Operator-led consultancy. Five practices. One bench. We diagnose, recommend, implement, and institutionalise.">
  <meta name="twitter:image" content="https://theresoluteadvisory.com/assets/og-card.png">
  <meta name="twitter:image:alt" content="Resolute Advisory — operator-led consultancy.">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="assets/favicon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">

  <!-- Structured data: Organization + WebSite -->
  <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://theresoluteadvisory.com/#organization",
      "name": "Resolute Advisory",
      "legalName": "WhyBrainium Consultancy Pvt. Ltd.",
      "url": "https://theresoluteadvisory.com/",
      "logo": "https://theresoluteadvisory.com/assets/RA_Full_Logo.png",
      "description": "Operator-led consultancy diagnosing and implementing across brand & growth, trade & export, technology, automation, and agriculture.",
      "email": "hello@theresoluteadvisory.com",
      "foundingDate": "2020",
      "areaServed": ["IN", "CA", "SG", "Asia", "North America"],
      "address": [
        { "@type": "PostalAddress", "addressLocality": "Mumbai", "addressCountry": "IN" },
        { "@type": "PostalAddress", "addressLocality": "Toronto", "addressCountry": "CA" },
        { "@type": "PostalAddress", "addressLocality": "Singapore", "addressCountry": "SG" }
      ],
      "sameAs": [
        "https://www.linkedin.com/company/the-resolute-advisory/",
        "https://www.instagram.com/resolute.advisory"
      ],
      "knowsAbout": [
        "Brand strategy",
        "Growth strategy",
        "Trade and export",
        "Agentic AI",
        "Web3 activation",
        "Industrial automation",
        "Agritech",
        "Hydroponics",
        "Performance marketing",
        "Creator partnerships"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://theresoluteadvisory.com/#website",
      "url": "https://theresoluteadvisory.com/",
      "name": "Resolute Advisory",
      "publisher": { "@id": "https://theresoluteadvisory.com/#organization" },
      "inLanguage": "en"
    },
    {
      "@type": "ProfessionalService",
      "name": "Resolute Advisory",
      "image": "https://theresoluteadvisory.com/assets/RA_Full_Logo.png",
      "url": "https://theresoluteadvisory.com/",
      "telephone": "",
      "priceRange": "$$$$",
      "serviceType": ["Brand & Growth Strategy","Trade & Export","Technology — Agentic AI, Web2, Web3 & Activation","Automation & Operations","Agriculture & Agritech"],
      "areaServed": ["India","Canada","Singapore","Asia"]
    }
  ]
}
</script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">

</head>

<body>

  <script is:inline>
    window.__TWEAKS = { heroMode: 'burst', cursorStyle: 'crosshair', accentDensity: 'low', loaderEnabled: true };
  </script>

  <slot />

  <script>
    // Original behaviour scripts, executed in the same order as the static site.
    import '../scripts/speedlines.js';
    import '../scripts/cursor.js';
    import '../scripts/loader.js';
    import '../scripts/hero.js';
    import '../scripts/parallax.js';
    import '../scripts/sections.js';
    import '../scripts/boot.js';
  </script>

</body>

</html>
