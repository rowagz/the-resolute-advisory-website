{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-resolute-advisory-website",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  // Build the Astro site before every deploy / versions upload, so Cloudflare
  // Workers Builds works with its default deploy command and no build command.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    // Astro static build output (`npm run build`)
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
